flag --prune help="Do not traverse into directories that match the search criteria. If you want to exclude specific directories, use the '--exclude=…' option" hide_short_help=#true default="false" {
    long_help "Do not traverse into directories that match the search criteria. If you want to exclude specific directories, use the '--exclude=…' option."
