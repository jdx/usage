flag --strip-cwd-prefix help="By default, relative paths are prefixed with './' when -x/--exec, -X/--exec-batch, or -0/--print0 are given, to reduce the risk of a path starting with '-' being treated as a command line option. Use this flag to change this behavior. If this flag is used without a value, it is equivalent to passing \"always\"" hide_short_help=#true require_equals=#true value_optional=#true {
    long_help "By default, relative paths are prefixed with './' when -x/--exec, -X/--exec-batch, or -0/--print0 are given, to reduce the risk of a path starting with '-' being treated as a command line option. Use this flag to change this behavior. If this flag is used without a value, it is equivalent to passing \"always\"."
    conflicts path "--search-path"
    arg <when> {
        choices {
            choice auto help="Use the default behavior"
            choice always help="Always strip the ./ at the beginning of paths"
            choice never help="Never strip the ./"
        }
    }
}
flag --one-file-system help="By default, fd will traverse the file system tree as far as other options dictate. With this flag, fd ensures that it does not descend into a different file system than the one it started in. Comparable to the -mount or -xdev filters of find(1)" hide_short_help=#true default="false" {
    alias "--mount" "--xdev" hide=#true
    long_help "By default, fd will traverse the file system tree as far as other options dictate. With this flag, fd ensures that it does not descend into a different file system than the one it started in. Comparable to the -mount or -xdev filters of find(1)."
}
flag --gen-completions hide=#true exclusive=#true value_optional=#true {
    arg <GEN_COMPLETIONS> {
        choices bash elvish fish powershell zsh
    }
}
arg "[pattern]" help="the search pattern (a regular expression, unless '--glob' is used; optional)" help_long="the search pattern which is either a regular expression (default) or a glob pattern (if --glob is used). If no pattern has been specified, every entry is considered a match. If your pattern starts with a dash (-), make sure to pass '--' first, or it will be considered as a flag (fd -- '-foo')." required=#false hide_default_value=#true default=""
arg "[path]…" help="the root directories for the filesystem search (optional)" help_long="The directory where the filesystem search is rooted (optional). If omitted, search the current working directory." required=#false var=#true var_min=1
group execs "--exec" "--exec-batch" "--list-details"
complete path type=path
complete search-path type=path
