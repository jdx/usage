name fd
bin fd
version "10.4.2"
about "A program to find entries in your filesystem with regex and glob based matching. By default, fd respects gitignore rules, ignores hidden directories, and is case insensitive."
unknown_flags error
args_override_self #false
usage "Usage: fd [OPTIONS] [pattern] [path]..."
flag "-H --hidden" help="Search hidden files and directories" default="false" {
    long_help "Include hidden directories and files in the search results (default: hidden files and directories are skipped). Files and directories are considered to be hidden if their name starts with a `.` sign (dot). Any files or directories that are ignored due to the rules described by --no-ignore are still ignored unless otherwise specified. The flag can be overridden with --no-hidden."
}
flag --no-hidden help="Overrides --hidden" hide=#true default="false"
flag "-I --no-ignore" help="Do not respect .(git|fd)ignore files" default="false" {
    long_help "Show search results from files and directories that would otherwise be ignored by '.gitignore', '.ignore', '.fdignore', or the global ignore file, The flag can be overridden with --ignore."
}
flag --ignore help="Overrides --no-ignore" hide=#true default="false"
flag --no-ignore-vcs help="Do not respect .gitignore files" hide_short_help=#true default="false" {
    long_help "Show search results from files and directories that would otherwise be ignored by '.gitignore' files. The flag can be overridden with --ignore-vcs."
}
flag --ignore-vcs help="Overrides --no-ignore-vcs" hide=#true default="false"
flag --no-require-git help="Do not require a git repository to respect gitignores. By default, fd will only respect global gitignore rules, .gitignore rules, and local exclude rules if fd detects that you are searching inside a git repository. This flag allows you to relax this restriction such that fd will respect all git related ignore rules regardless of whether you're searching in a git repository or not" hide_short_help=#true default="false" {
    long_help #"""
Do not require a git repository to respect gitignores. By default, fd will only respect global gitignore rules, .gitignore rules, and local exclude rules if fd detects that you are searching inside a git repository. This flag allows you to relax this restriction such that fd will respect all git related ignore rules regardless of whether you're searching in a git repository or not.

This flag can be disabled with --require-git.
"""#
}
flag --require-git help="Overrides --no-require-git" hide=#true default="false"
flag --no-ignore-parent help="Do not respect .(git|fd)ignore files in parent directories" hide_short_help=#true default="false" {
    long_help "Show search results from files and directories that would otherwise be ignored by '.gitignore', '.ignore', or '.fdignore' files in parent directories. The flag can be overridden with --ignore-parent."
}
flag --ignore-parent help="Overrides --no-ignore-parent" hide=#true default="false"
flag --no-global-ignore-file help="Do not respect the global ignore file" hide=#true default="false"
flag "-u --unrestricted" help="Unrestricted search, alias for '--no-ignore --hidden'" var=#true hide_short_help=#true count=#true default="0" {
    long_help "Perform an unrestricted search, including ignored and hidden files. This is an alias for '--no-ignore --hidden'."
}
flag "-s --case-sensitive" help="Case-sensitive search (default: smart case)" default="false" {
    long_help "Perform a case-sensitive search. By default, fd uses case-insensitive searches, unless the pattern contains an uppercase character (smart case)."
}
flag "-i --ignore-case" help="Case-insensitive search (default: smart case)" default="false" {
    long_help "Perform a case-insensitive search. By default, fd uses case-insensitive searches, unless the pattern contains an uppercase character (smart case)."
}
flag "-g --glob" help="Glob-based search (default: regular expression)" conflicts=--fixed-strings default="false" {
    long_help "Perform a glob-based search instead of a regular expression search."
}
flag --regex help="Regular-expression based search (default)" hide_short_help=#true default="false" {
    long_help "Perform a regular-expression based search (default). This can be used to override --glob."
}
flag "-F --fixed-strings" help="Treat pattern as literal string instead of regex" hide_short_help=#true default="false" {
    alias "--literal" hide=#true
    long_help "Treat the pattern as a literal string instead of a regular expression. Note that this also performs substring comparison. If you want to match on an exact filename, consider using '--glob' or '--exact' instead."
}
flag --exact help="Match the entire filename exactly (literal, non-substring)" hide_short_help=#true default="false" {
    long_help "Perform an exact match. This is equivalent to '--fixed-strings' but requires the pattern to match the entire filename (or path if '--full-path' is used), rather than a substring. Special regex characters in the pattern are treated as literal characters."
    conflicts "--glob" "--fixed-strings"
}
flag --and help="Additional search patterns that need to be matched" var=#true hide_short_help=#true allow_hyphen_values=#true {
    long_help "Add additional required search patterns, all of which must be matched. Multiple additional patterns can be specified. The patterns are regular expressions, unless '--glob' or '--fixed-strings' is used."
    arg <pattern>… var=#true
}
flag "-a --absolute-path" help="Show absolute instead of relative paths" default="false" {
    long_help "Shows the full path starting from the root as opposed to relative paths. The flag can be overridden with --relative-path."
}
flag --relative-path help="Overrides --absolute-path" hide=#true default="false"
flag "-l --list-details" help="Use a long listing format with file metadata" conflicts=--absolute-path default="false" {
    long_help "Use a detailed listing format like 'ls -l'. This is basically an alias for '--exec-batch ls -l' with some additional 'ls' options. This can be used to see more metadata, to show symlink targets and to achieve a deterministic sort order."
