name tak
bin tak
unknown_flags error
subcommand_required #true
flag --env-deny help="Remove a variable from the environment of measured commands. Repeatable. Replaces the default list rather than adding to it." global=#true var=#true {
    long_help "Remove a variable from the environment of measured commands. Repeatable.\nReplaces the default list rather than adding to it."
    arg <VAR>
}
flag --env-allow help="Keep a variable that --env-deny would remove. Repeatable." global=#true var=#true {
    arg <VAR>
}
flag --gate-pct help="Percentage an instruction count may rise before `compare` fails." global=#true {
    arg <PCT>
}
flag --no-credit help="Leave the line naming tak off the end of generated reports." global=#true
flag --runner help="Machine class to record under. Overrides the derived name." global=#true {
    arg <CLASS>
}
cmd run help="Benchmark a command, or everything declared in tak.toml." {
    flag --bench help="Name to record this measurement under. With no command, selects a single benchmark from tak.toml instead of running all of them." {
        long_help "Name to record this measurement under. With no command, selects a\nsingle benchmark from tak.toml instead of running all of them."
        arg <BENCH>
    }
    flag --runs help="Timed runs. Overrides tak.toml when both are given." {
        arg <RUNS>
    }
    flag --warmup help="Untimed warmup runs. Overrides tak.toml when both are given." {
        arg <WARMUP>
    }
    flag --no-counters help="Skip instruction counting even where valgrind is available."
    flag --record help="Append the result to refs/notes/tak for the current commit."
    arg "[CMD]..." help="Command to benchmark, after `--`. Omit to run what tak.toml declares." double_dash=required
}
cmd history help="Show recorded history for a commit." {
    flag --remote help="Remote to refresh notes from." default=origin {
        arg <REMOTE>
    }
    arg "[REV]" help="Revision to read. Defaults to HEAD." default=HEAD
}
cmd push help="Push recorded measurements to the remote." {
    flag --remote help="Remote to use for git-notes synchronization." default=origin {
        arg <REMOTE>
    }
}
cmd init help="Teach plain `git fetch` about the notes ref." {
    flag --remote help="Remote to use for git-notes synchronization." default=origin {
        arg <REMOTE>
    }
}
cmd backfill help="Benchmark published release binaries to bootstrap history." {
    long_help "Benchmark published release binaries to bootstrap history.\n\nA new adopter's first chart is empty. Rather than rebuilding a project at\na hundred historical commits, download what it already published."
    flag --repo help="Repository to pull releases from, as \"owner/name\". Defaults to the `origin` remote of the current repository." {
        long_help "Repository to pull releases from, as \"owner/name\". Defaults to the\n`origin` remote of the current repository."
        arg <REPO>
    }
    flag --bin help="Executable name to look for inside each release archive. Defaults to the repository name." {
        long_help "Executable name to look for inside each release archive. Defaults to\nthe repository name."
        arg <BIN>
    }
    flag --bench help="Name to record measurements under." default=release {
        arg <BENCH>
    }
    flag --limit help="Most recent releases to measure." default="20" {
        arg <LIMIT>
    }
    flag --runs help="Timed runs per release." default="10" {
        arg <RUNS>
    }
    flag --dry-run help="Measure but do not write to refs/notes/tak."
    arg "[ARGS]..." help="Arguments passed to the downloaded binary, after `--`. Defaults to `--version`, which every CLI answers cheaply." double_dash=required {
        long_help "Arguments passed to the downloaded binary, after `--`.\nDefaults to `--version`, which every CLI answers cheaply."
    }
}
cmd compare help="Compare this commit's measurements against another's." {
    long_help "Compare this commit's measurements against another's.\n\nFails when an instruction count has risen by more than `gate_pct`. Wall\nclock is reported and never gated."
    flag --rev help="Revision to compare. Defaults to HEAD." default=HEAD {
        arg <REV>
    }
    flag --remote help="Remote to refresh notes from." default=origin {
        arg <REMOTE>
    }
    flag --no-gate help="Report without failing, whatever the numbers say."
    arg "[BASE]" help="Revision to compare against." default="origin/main"
}
cmd doctor help="Diagnose the git-notes plumbing." {
}
cmd settings help="Show every setting, its resolved value, and where that value came from." {
    flag --docs help="Include the full description of each setting."
}
cmd usage help="Generate the CLI specification used to build the documentation." hide=#true {
}
