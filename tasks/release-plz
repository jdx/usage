#!/usr/bin/env bash
# shellcheck shell=bash
set -euxo pipefail

# clap_usage is versioned by hand and released on its own cadence, so it needs
# its own check: the usage-lib release cycle below would otherwise never publish
# it. That omission is why it sat unpublished at 2.0.3 from 2025-01 to 2026-07.
#
# It depends on usage-lib at the workspace version, so it can only be published
# once that version is on crates.io — hence a function called in dependency
# order rather than a block at the top of the script.
crate_version_is_published() {
  local crate="$1" version="$2" index_path
  case "${#crate}" in
  1) index_path="1/$crate" ;;
  2) index_path="2/$crate" ;;
  3) index_path="3/${crate:0:1}/$crate" ;;
  *) index_path="${crate:0:2}/${crate:2:2}/$crate" ;;
  esac
  curl -fsS "https://index.crates.io/$index_path" |
    grep -q "\"vers\":\"$version\""
}

publish_crate_if_needed() {
  local crate="$1" version
  version="$(cargo pkgid "$crate" | cut -d# -f2 | cut -d@ -f2)"
  if crate_version_is_published "$crate" "$version"; then
    return
  fi
  echo "Releasing $crate $version"
  if [ "${usage_dry_run:-}" != 1 ]; then
    cargo publish -p "$crate"
  fi
}

released_versions="$(git tag --list | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+(-rc\.[0-9]+)?$')"
cur_version="$(cargo pkgid usage-lib | cut -d# -f2 | cut -d@ -f2)"
if ! echo "$released_versions" | grep -q "^v$cur_version$"; then
  echo "Releasing $cur_version"
  if [ "${usage_dry_run:-}" != 1 ]; then
    # Dependency order: leaves first, then crates that re-export or depend on them.
    # usage-rs lists usage-config / usage-validation / usage-test as optional deps;
    # cargo publish still requires those packages to exist on crates.io.
    publish_crate_if_needed usage-argv
    publish_crate_if_needed usage-derive
    publish_crate_if_needed usage-config
    publish_crate_if_needed usage-validation
    publish_crate_if_needed usage-test
    publish_crate_if_needed usage-rs
    publish_crate_if_needed usage-lib
    publish_crate_if_needed usage-dynamic
    publish_crate_if_needed clap_usage
    publish_crate_if_needed usage-cli
    git tag "v$cur_version"
    git push --tags
  fi
  exit 0
fi

# usage-lib's current version is already released, so clap_usage's dependency
# is satisfied; catch it up if it is behind. usage-argv rides the shared version
# and depends on nothing, so the same catch-up applies to it.
#
# usage-config and usage-validation shipped in-tree at the tagged version but were
# never published — publish them here so the next `usage-rs` release can depend on
# them. Do not catch up usage-test / usage-rs / usage-dynamic at the already-tagged
# version:
# crates.io usage-argv at that version has no features, while in-tree manifests
# require its `complete` and `spec` features. Those crates debut on the next version bump
# (first branch above), which republishes argv with the features they need.
publish_crate_if_needed usage-argv
publish_crate_if_needed usage-derive
publish_crate_if_needed usage-config
publish_crate_if_needed usage-validation
publish_crate_if_needed clap_usage

# Anchor the range at the current release and include commits regardless of changed paths.
# Empty conventional commits (for example, `fix(cli): trigger release pr`) must also
# reach git-cliff so they can trigger a version bump and appear in the release notes.
release_range="v$cur_version..HEAD"
version="$(git cliff "$release_range" --bumped-version)"

if [ "v$cur_version" == "$version" ]; then
  echo "No version bump since $version; nothing to release"
  exit 0
fi

if [ "${usage_dry_run:-}" == 1 ]; then
  echo "version: $version"
  changelog="$(git cliff "$release_range" --tag "$version" --strip all)"
  echo "changelog: $changelog"
  exit 0
fi

# Generate changelog using git-cliff (LLM editorialization happens in release.yml after merge)
git cliff "$release_range" --tag "$version" --prepend CHANGELOG.md

# Get the unreleased notes for PR body
# Strip version header since PR title already has version
PR_BODY="$(git cliff "$release_range" --tag "$version" --strip all | tail -n +3)"

# Bump the published crates to the release version, as `cargo set-version` did. Done
# here rather than with cargo-edit because that has no prebuilt binary: mise compiled
# it from source in every CI job that installs the project's tools.
#
# clap_usage is versioned by hand. Everything still at 0.0.0 is unpublished
# (xtask, conformance, benches) and must stay there. Stamping those too makes
# `cargo update` write 6.x into Cargo.lock, while git add below does not include
# their manifests — MSRV `cargo check --locked` then fails
# (https://github.com/jdx/usage/pull/795).
set_workspace_version() {
  python3 - "$1" <<'PY'
import json
import re
import subprocess
import sys
from pathlib import Path

new = sys.argv[1]
data = json.loads(
    subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--no-deps", "--offline"],
        check=True, capture_output=True, text=True,
    ).stdout
)
members = set(data["workspace_members"])
packages = [p for p in data["packages"] if p["id"] in members]
bumped = {
    p["name"]
    for p in packages
    if p["name"] != "clap_usage" and p["version"] != "0.0.0"
}

# The `version` line in each bumped crate's [package] table.
for p in packages:
    if p["name"] not in bumped:
        continue
    path = Path(p["manifest_path"])
    text = path.read_text()
    section = re.search(r"^\[package\][^\n]*\n(?:(?!\[).*\n)*", text, re.MULTILINE)
    if not section:
        raise SystemExit(f"{path}: no [package] table")
    head, count = re.subn(
        r'^(version[ \t]*=[ \t]*)"[^"]*"',
        lambda m: f'{m.group(1)}"{new}"',
        section.group(0), count=1, flags=re.MULTILINE,
    )
    if count != 1:
        raise SystemExit(f"{path}: no literal [package] version to set")
    path.write_text(text[: section.start()] + head + text[section.end() :])

# Requirements on path dependencies that point at a bumped crate, in
# [workspace.dependencies] and in members:
# `usage-lib = { path = "./lib", version = "6.10.0" }` -> version = "<new>".
inline_dep = re.compile(r"^([ \t]*([A-Za-z0-9_-]+)[ \t]*=[ \t]*\{)([^\n]*)(\}[ \t]*)$", re.MULTILINE)


def bump(m):
    body = m.group(3)
    renamed = re.search(r'\bpackage[ \t]*=[ \t]*"([^"]+)"', body)
    name = renamed.group(1) if renamed else m.group(2)
    if name not in bumped or not re.search(r"\bpath[ \t]*=", body):
        return m.group(0)
    body = re.sub(
        r'(\bversion[ \t]*=[ \t]*)"[^"]*"', lambda v: f'{v.group(1)}"{new}"', body
    )
    return m.group(1) + body + m.group(4)


manifests = [Path(data["workspace_root"]) / "Cargo.toml"]
manifests += [Path(p["manifest_path"]) for p in packages]
for path in dict.fromkeys(manifests):
    text = path.read_text()
    updated = inline_dep.sub(bump, text)
    if updated != text:
        path.write_text(updated)
PY
  cargo update --workspace
  # Fail the release if anything was missed, e.g. a manifest reformatted so a
  # pattern above no longer matches: every bumped crate and every versioned path
  # dependency on one, in the manifests and in what cargo resolves.
  python3 - "$1" <<'PY'
import json
import subprocess
import sys
import tomllib
from pathlib import Path

new = sys.argv[1]
data = json.loads(
    subprocess.run(
        ["cargo", "metadata", "--format-version", "1", "--no-deps", "--offline"],
        check=True, capture_output=True, text=True,
    ).stdout
)
members = set(data["workspace_members"])
packages = [p for p in data["packages"] if p["id"] in members]
# The same selection as the bump; a crate it missed is still at its old version.
bumped = {
    p["name"]
    for p in packages
    if p["name"] != "clap_usage" and p["version"] != "0.0.0"
}
errors = []
if not bumped:
    errors.append("no crates were selected for the bump")
for p in packages:
    if p["name"] in bumped and p["version"] != new:
        errors.append(f"{p['name']} is {p['version']}, not {new}")
    for dep in p["dependencies"]:
        if dep["name"] in bumped and dep.get("path") and dep["req"] not in ("*", f"^{new}"):
            errors.append(f"{p['name']} requires {dep['name']} {dep['req']}, not ^{new}")


def dep_tables(doc):
    for key in ("dependencies", "dev-dependencies", "build-dependencies"):
        yield doc.get(key, {})
    for target in doc.get("target", {}).values():
        yield from dep_tables(target)


root = Path(data["workspace_root"]) / "Cargo.toml"
manifests = [root] + [Path(p["manifest_path"]) for p in packages]
for path in dict.fromkeys(manifests):
    doc = tomllib.loads(path.read_text())
    tables = list(dep_tables(doc)) + [doc.get("workspace", {}).get("dependencies", {})]
    for table in tables:
        for key, spec in table.items():
            if not isinstance(spec, dict) or "path" not in spec or "version" not in spec:
                continue
            if spec.get("package", key) in bumped and spec["version"] != new:
                errors.append(f"{path}: {key} requires {spec['version']}, not {new}")
if errors:
    raise SystemExit("version bump incomplete:\n" + "\n".join(errors))
print(f"bumped {len(bumped)} crates to {new}")
PY
}
set_workspace_version "${version#v}"

# User-facing dependency examples track the compatible major, not a point release.
# Keep `version = "6"` through every 6.x release and change it only for 7.0.0.
bump_rust_doc_major_versions() {
  local from="$1" to="$2"
  python3 - "$from" "$to" <<'PY'
import re
import sys
from pathlib import Path

old, new = sys.argv[1:]
paths = [
    *Path("docs/rust").glob("*.md"),
    Path("usage-rs/src/lib.rs"),
    Path("test/src/lib.rs"),
]
dependency = re.compile(
    r'^((?:\s*//!\s*)?usage(?:-[a-z]+)?\s*=\s*\{[^\n]*?\bversion\s*=\s*")'
    + re.escape(old)
    + r'("[^\n]*\})',
    re.MULTILINE,
)
changed = 0
for path in paths:
    text = path.read_text()
    text, count = dependency.subn(rf"\g<1>{new}\2", text)
    if count:
        path.write_text(text)
        changed += count
if changed == 0:
    raise SystemExit(f"no Rust dependency examples used major {old}")
print(f"updated {changed} Rust dependency examples from major {old} to {new}")
PY
}

new_major="${version#v}"
new_major="${new_major%%.*}"
old_major="${cur_version%%.*}"
if [ "$new_major" != "$old_major" ]; then
  bump_rust_doc_major_versions "$old_major" "$new_major"
fi

mise run render

git config user.name mise-en-dev
git config user.email 123107610+mise-en-dev@users.noreply.github.com
cargo update
# Nested lockfiles pin path deps at the workspace version. Tests run
# `cargo run --manifest-path` against them, which rewrites the lock when
# set-version bumps those crates — CI then fails the render dirty-tree
# gate (https://github.com/jdx/usage/actions/runs/32546629713).
while IFS= read -r lock; do
  cargo generate-lockfile --manifest-path "${lock%/Cargo.lock}/Cargo.toml"
done < <(git ls-files 'usage-rs/tests/fixtures/*/Cargo.lock')
aube update
mise run lint-fix
git add \
  {./,argv/,cli/,config/,derive/,lib/,test/,usage-rs/,usage-dynamic/,validation/}Cargo.* \
  usage-rs/tests/fixtures/*/Cargo.lock \
  package.json aube-lock.yaml \
  cli/usage.usage.kdl \
  docs/cli/reference/* \
  docs/rust/*.md \
  usage-rs/src/lib.rs \
  test/src/lib.rs \
  CHANGELOG.md
git checkout -B release
git commit -m "chore: release $version"
git push origin release --force

if [[ "$(gh pr list --label release)" == "" ]]; then
  gh pr create --title "chore: release $version" --body "$PR_BODY" --label "release" --head release
else
  gh pr edit --title "chore: release $version" --body "$PR_BODY"
fi
