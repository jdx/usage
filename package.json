{
  "name": "@jdx/usage",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "node --test docs/.vitepress/social-images.test.mjs && vitepress build docs && node docs/.vitepress/check-social-images.mjs docs/.vitepress/dist",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "vitepress": "1.6.4"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ],
      "libc": [
        "current",
        "glibc"
      ]
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "printWidth": 80
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "semver": "^7.8.5"
  }
}
