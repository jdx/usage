amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
    ["prettier"] = Builtins.prettier

    // `usage-rs/tests/fixtures/*` have a Cargo.toml but are not workspace
    // members, so run `--all` at the root instead of per-manifest.
    ["cargo-fmt"] = (Builtins.cargo_fmt) {
        workspace_indicator = null
        check = new CommandSpec {
            command = "cargo fmt --all -- --check"
            effect = "read"
        }
        check_list_files = new CommandSpec {
            command = "cargo fmt --all -- --check --files-with-diff"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "cargo fmt --all"
            effect = "write"
        }
    }

    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        workspace_indicator = null
        check = new CommandSpec {
            command = "cargo clippy --all --all-features --all-targets -- -D warnings"
            effect = "write"
        }
        fix = new CommandSpec {
            command = "cargo clippy --all --all-features --fix --allow-dirty --allow-staged -- -D warnings"
            effect = "write"
        }
    }

    ["go"] {
        glob = List("go/**/*.go", "benches/go/**/*.go")
        check = "mise run lint:go"
        fix = "mise run lint-fix:go"
    }

    ["rust-docs-version"] {
        glob = List("docs/rust/*.md", "usage-rs/src/lib.rs", "test/src/lib.rs", "lib/Cargo.toml")
        check = "mise run lint:rust-docs-version"
    }

    ["cargo-semver-checks"] {
        glob = List("lib/**/*.rs", "lib/Cargo.toml")
        check = "mise run lint:semver"
    }
}
