amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
    ["prettier"] = Builtins.prettier

    ["cargo-fmt"] = Builtins.cargo_fmt

    // Per-manifest, `--all-features` resolves differently than it does across the
    // workspace and trips `-D warnings` on usage-argv, so lint the workspace once.
    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        workspace_indicator = null
        check = new CommandSpec {
            command = "cargo clippy --all --all-features --all-targets -- -D warnings"
            effect = "write"
        }
        fix = new CommandSpec {
            command = "cargo clippy --all --all-features --fix --allow-dirty --allow-staged -- -D warnings"
            effect = "write"
        }
    }

    ["gofumpt"] = Builtins.go_fumpt

    // Serial runners, not parallel: golangci-lint takes a lock, and hk runs this step once
    // per Go module. Without the flag the second instance fails instead of waiting.
    ["golangci-lint"] = (Builtins.golangci_lint) {
        check = new CommandSpec {
            command = "golangci-lint run --allow-serial-runners --fix=false ./..."
            effect = "write"
        }
        fix = new CommandSpec {
            command = "golangci-lint run --allow-serial-runners --fix ./..."
            effect = "write"
        }
    }
    ["go-fix"] = Builtins.go_fix
    ["go-mod-tidy"] = Builtins.gomod_tidy

    ["rust-docs-version"] {
        glob = List("docs/rust/*.md", "usage-rs/src/lib.rs", "test/src/lib.rs", "lib/Cargo.toml")
        check = "mise run lint:rust-docs-version"
    }

    ["cargo-semver-checks"] {
        glob = List("lib/**/*.rs", "lib/Cargo.toml")
        check = "mise run lint:semver"
    }
}
