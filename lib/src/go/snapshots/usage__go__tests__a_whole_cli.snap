			case FlagVerbose:
				out.Verbose = !ev.Negated
			case FlagColor:
				out.Color = !ev.Negated
			case FlagJobs:
				out.Jobs = ev.Value
			case FlagInclude:
				if ev.HasValue {
					out.Include = append(out.Include, ev.Value)
				}
			case FlagInstallForce:
				cmdInstallV.Force = !ev.Negated
			case FlagConfigLsNoHeader:
				cmdConfigLsV.NoHeader = !ev.Negated
