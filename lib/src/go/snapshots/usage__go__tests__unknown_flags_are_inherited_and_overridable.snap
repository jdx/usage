	UnknownFlags: argv.UnknownFlagsError,
}

// strict
var cmdStrict = &argv.Command{
	Name:         "strict",
	Key:          CmdStrict,
	Subcommands:  []*argv.Command{cmdStrictDeep},
	UnknownFlags: argv.UnknownFlagsError,
