{%- if not flag.hide_env and flag.env %} [env: {{ flag.env }}]{%- endif %}
{%- if not flag.hide_default_value and flag.default %} (default: {{ flag.default | join(sep=", ") }}){%- endif %}
{%- endif %}
{%- endfor %}
{%- endfor %}

